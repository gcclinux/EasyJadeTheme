  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9aa8a0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#4da6ff"
      }
    },
    {
      "scope": [
        "string",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#00ff88"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#ffb86c"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#7dffb3"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "support.class",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#80d1ff"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#d0ffd0"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#ffdb80"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#7dffb3"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    }
  ]
}
