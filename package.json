{
  "name": "EasyJadeTheme",
  "displayName": "EasyJade Theme",
  "description": "A beautiful bespoke jade colour theme for VS Code",
  "version": "0.1.4",
  "scripts": {
    "vsce:package": "vsce package"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "EasyJade Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/jade-dark-color-theme.json"
      }
      ,
      {
        "label": "EasyJade Light",
        "uiTheme": "vs",
        "path": "./themes/jade-light-color-theme.json"
      }
      ,
      {
        "label": "EasyJade High Contrast",
        "uiTheme": "hc-black",
        "path": "./themes/jade-high-contrast-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gcclinux/EasyJadeTheme.git"
  },
  "publisher": "gcclinux"
}

